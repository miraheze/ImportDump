[
	{
		"name": "import_requests",
		"comment": "",
		"columns": [
			{
				"name": "request_id",
				"comment": "Unique auto-increment ID",
				"type": "bigint",
				"options": { "autoincrement": true, "notnull": true, "unsigned": true }
			},
			{
				"name": "request_actor",
				"comment": "",
				"type": "bigint",
				"options": { "notnull": true, "unsigned": true }
			},
			{
				"name": "request_timestamp",
				"comment": "",
				"type": "mwtimestamp",
				"options": { "notnull": true }
			},
			{
				"name": "request_source",
				"comment": "",
				"type": "string",
				"options": { "notnull": true }
			},
			{
				"name": "request_target",
				"comment": "",
				"type": "string",
				"options": { "notnull": true, "length": 64 }
			},
			{
				"name": "request_reason",
				"comment": "",
				"type": "blob",
				"options": { "notnull": true, "length": 65530 }
			},
			{
				"name": "request_status",
				"comment": "",
				"type": "mwenum",
				"options": { "notnull": true,
					"CustomSchemaOptions": {
						"enum_values": [ "complete", "declined", "failed", "inprogress", "partial", "pending", "starting", "verifying" ]
					}
				}
			},
			{
				"name": "request_stage",
				"comment": "The last import stage that was started, or NULL if none",
				"type": "string",
				"options": { "notnull": false, "length": 32 }
			},
			{
				"name": "request_history",
				"comment": "Whether the dump seems to have the full revision history, or NULL if it was not checked",
				"type": "mwenum",
				"options": { "notnull": false,
					"CustomSchemaOptions": {
						"enum_values": [ "full", "partial", "unknown" ]
					}
				}
			},
			{
				"name": "request_requirements",
				"comment": "JSON list of the extensions that the dump needs, or NULL if it was not checked",
				"type": "blob",
				"options": { "notnull": false, "length": 65530 }
			},
			{
				"name": "request_skipped",
				"comment": "JSON list of the image files that are left out of the import and why, or NULL if none were",
				"type": "blob",
				"options": { "notnull": false, "length": 16777215 }
			},
			{
				"name": "request_file_count",
				"comment": "How many image files were stored for an images request, or NULL if it was not recorded",
				"type": "integer",
				"options": { "notnull": false, "unsigned": true }
			},
			{
				"name": "request_file_size",
				"comment": "The total size in bytes of the image files that were stored, or NULL if it was not recorded",
				"type": "bigint",
				"options": { "notnull": false, "unsigned": true }
			},
			{
				"name": "request_type",
				"comment": "What is imported, pages from an XML dump or image files",
				"type": "mwenum",
				"options": { "notnull": true, "default": "xml",
					"CustomSchemaOptions": {
						"enum_values": [ "images", "xml" ]
					}
				}
			},
			{
				"name": "request_linked_id",
				"comment": "The request that this one was made together with, or NULL if it stands alone",
				"type": "bigint",
				"options": { "notnull": false, "unsigned": true }
			},
			{
				"name": "request_locked",
				"comment": "",
				"type": "mwtinyint",
				"options": { "notnull": true, "unsigned": true, "default": 0 }
			},
			{
				"name": "request_private",
				"comment": "",
				"type": "mwtinyint",
				"options": { "notnull": true, "unsigned": true, "default": 0 }
			},
			{
				"name": "request_overwrite",
				"comment": "",
				"type": "mwtinyint",
				"options": { "notnull": true, "unsigned": true, "default": 0 }
			},
			{
				"name": "request_skip_dupes",
				"comment": "",
				"type": "mwtinyint",
				"options": { "notnull": true, "unsigned": true, "default": 1 }
			}
		],
		"indexes": [
			{
				"name": "request_actor_timestamp",
				"comment": "",
				"columns": [ "request_actor", "request_timestamp" ],
				"unique": false
			},
			{
				"name": "request_timestamp",
				"comment": "",
				"columns": [ "request_timestamp" ],
				"unique": false
			},
			{
				"name": "request_target",
				"comment": "",
				"columns": [ "request_target" ],
				"unique": false
			},
			{
				"name": "request_status",
				"comment": "",
				"columns": [ "request_status" ],
				"unique": false
			},
			{
				"name": "request_linked_id",
				"comment": "",
				"columns": [ "request_linked_id" ],
				"unique": false
			}
		],
		"pk": [ "request_id" ]
	},
	{
		"name": "import_request_comments",
		"comment": "",
		"columns": [
			{
				"name": "request_comment_id",
				"comment": "Unique auto-increment ID",
				"type": "bigint",
				"options": { "autoincrement": true, "notnull": true, "unsigned": true }
			},
			{
				"name": "request_id",
				"comment": "",
				"type": "bigint",
				"options": { "notnull": true, "unsigned": true }
			},
			{
				"name": "request_comment_actor",
				"comment": "",
				"type": "bigint",
				"options": { "notnull": true, "unsigned": true }
			},
			{
				"name": "request_comment_timestamp",
				"comment": "",
				"type": "mwtimestamp",
				"options": { "notnull": true }
			},
			{
				"name": "request_comment_text",
				"comment": "",
				"type": "blob",
				"options": { "notnull": true, "length": 65530 }
			}
		],
		"indexes": [
			{
				"name": "request_id",
				"comment": "",
				"columns": [ "request_id" ],
				"unique": false
			},
			{
				"name": "request_comment_timestamp",
				"comment": "",
				"columns": [ "request_comment_timestamp" ],
				"unique": false
			}
		],
		"pk": [ "request_comment_id" ]
	},
	{
		"name": "import_request_handlers",
		"comment": "Everyone who has handled a request, such as by starting it or changing its status",
		"columns": [
			{
				"name": "request_id",
				"comment": "",
				"type": "bigint",
				"options": { "notnull": true, "unsigned": true }
			},
			{
				"name": "request_handler_actor",
				"comment": "",
				"type": "bigint",
				"options": { "notnull": true, "unsigned": true }
			}
		],
		"indexes": [],
		"pk": [ "request_id", "request_handler_actor" ]
	}
]
